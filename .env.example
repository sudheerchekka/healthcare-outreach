# ── Twilio credentials ─────────────────────────────────────────────────────
TWILIO_TAC_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_AUTH_TOKEN=your_auth_token
TWILIO_TAC_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_API_TOKEN=your_api_token
TWILIO_TAC_PHONE_NUMBER=+1xxxxxxxxxx

# ── Voice configuration ────────────────────────────────────────────────────
# Your ngrok public domain (without https://), e.g. abc123.ngrok.io
TWILIO_TAC_VOICE_PUBLIC_DOMAIN=your-ngrok-domain.ngrok.io

# Conversation Configuration ID (conv_configuration_*)
TWILIO_TAC_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxx

# Override: always dial this number for outbound calls (testing)
TWILIO_TAC_OUTBOUND_CALL_TO=+1xxxxxxxxxx

# ── Twilio Memory Store ────────────────────────────────────────────────────
TWILIO_TAC_MEMORY_STORE_ID=your_memory_store_id

# ── Conversation Intelligence ──────────────────────────────────────────────
# SID of the summary operator (from your CI configuration)
TWILIO_TAC_CI_SUMMARY_OPERATOR_SID=

# ── AWS AgentCore / Bedrock ────────────────────────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-4-6-v1:0
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# On EC2 with an IAM role, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# are not required — credentials are picked up automatically.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
