# ── Twilio credentials ─────────────────────────────────────────────────────
# Used by Node.js app server (api.ts) AND Python TAC server (server.py)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_TOKEN=your_api_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Python TAC SDK reads TWILIO_TAC_* vars (set equal to the above)
TWILIO_TAC_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_AUTH_TOKEN=your_auth_token
TWILIO_TAC_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_API_TOKEN=your_api_token
TWILIO_TAC_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_TAC_ENVIRONMENT=prod

# ── Voice configuration ────────────────────────────────────────────────────
# Your ngrok public domain (with https://), e.g. https://abc123.ngrok.io
VOICE_PUBLIC_DOMAIN=https://your-ngrok-domain.ngrok.io

# Conversation Orchestrator service SID (conv_configuration_*) — used by TAC SDK for voice/SMS
CONVERSATION_SERVICE_ID=conv_configuration_xxxxxxxx
TWILIO_TAC_CONVERSATION_SERVICE_SID=conv_configuration_xxxxxxxx   # same value

# Classic Conversations service SID (IS...) — used by web chat widget
# Twilio Console → Conversations → Services → your Classic service
# Set Post-event webhook on this service to: https://your-ngrok/conversations-webhook (onMessageAdded)
TWILIO_CHAT_CONVERSATION_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override: always dial this number for outbound calls (testing)
OUTBOUND_CALL_TO=+1xxxxxxxxxx
# Set to "true" to manually write an observation on SMS send (CO does this automatically when SMS channel is configured)
SMS_WRITE_OBSERVATION=false

# ── Human Agent Escalation (Twilio Flex) ──────────────────────────────────
ESCALATION_ENABLED=false
TWILIO_FLEX_HANDOFF_APPLICATION_SID=
# Flex worker identity (email/username) added as Conversations participant so agent can type in chat tasks
FLEX_AGENT_IDENTITY=
# Flex Flow SID (FLxxx) bound to your Conversations service — enables Flex task details panel for chat tasks
FLEX_CHAT_FLOW_SID=
TWILIO_FLEX_DEFAULT_QUEUE=healthcare
# TaskRouter Workspace SID — used to patch task attributes for browser/WebRTC escalations
# Twilio Console → Flex → Manage → Workspaces (or TaskRouter → Workspaces)
TWILIO_FLEX_WORKSPACE_SID=
#using it to enqueue broswer call to Flex
TWILIO_FLEX_WORKFLOW_SID=
TWILIO_FLEX_ESCALATION_ANNOUNCEMENT=Of course! Let me connect you with one of our care specialists right away. Please hold for just a moment.

# ── Twilio Verify ──────────────────────────────────────────────────────────
# Create a Verify Service in Twilio Console → Verify → Services
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true to log full CI webhook payloads and per-operator detail (verbose, off by default)
CI_VERBOSE_LOGS=false

# Healthcare Conversation Intelligence operators
TWILIO_TAC_CI_SUMMARY_OPERATOR_SID=
TWILIO_TAC_CI_OUTREACH_OPERATOR_SID=
CI_OPERATOR_1_SID=
CI_OPERATOR_1_LABEL=Sentiment
CI_OPERATOR_2_SID=
CI_OPERATOR_2_LABEL=Next Best Response
CI_OPERATOR_3_SID=
CI_OPERATOR_3_LABEL=Compliance Check
CI_OPERATOR_4_SID=
CI_OPERATOR_4_LABEL=Call Score

# ── PubSec app (placeholder) ───────────────────────────────────────────────
# URL: http://localhost:8001/pubsec/members.html
PUBSEC_PHONE_NUMBER=
PUBSEC_MEMORY_STORE_ID=
PUBSEC_OUTBOUND_CALL_TO=
PUBSEC_SMS_WRITE_OBSERVATION=false
PUBSEC_CI_SUMMARY_OPERATOR_SID=
PUBSEC_CI_OUTREACH_OPERATOR_SID=

# ── Enterprise Knowledge Base ────────────────────────────────────────────────
# KB ID from memory.twilio.com/v1/ControlPlane/KnowledgeBases — leave blank to disable
HEALTHCARE_KB_ID=

# ── Enterprise Knowledge Base ────────────────────────────────────────────────
# KB ID from memory.twilio.com/v1/ControlPlane/KnowledgeBases — leave blank to disable
HEALTHCARE_KB_ID=

# ── Legacy / shared (kept for backwards compat) ────────────────────────────
MEMORY_STORE_ID=your_memory_store_id
TWILIO_TAC_MEMORY_STORE_ID=your_memory_store_id
TWILIO_TAC_MEMORY_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TAC_MEMORY_API_TOKEN=your_api_token

# ── AWS AgentCore ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# AgentCore Runtime ARN — Python TAC server connects to this agent via presigned WebSocket
# Get from: agentcore status (in src/apps/healthcare/agent/)
VOICE_CONCIERGE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/AGENT_ID

# AWS credentials — use one of:
#   AWS_PROFILE (named profile in ~/.aws/credentials)
#   AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (explicit keys)
#   Neither — on EC2 with an IAM role, credentials are picked up automatically
# For local dev with a named profile:
AWS_PROFILE=your-aws-profile
# For Docker (profile files don't exist in container — use explicit keys):
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_PROFILE=   # leave blank when using explicit keys

# Agent system prompt — overrides the default in agent/src/main.py (optional)
# AGENT_SYSTEM_PROMPT=You are an Owl Health care coordination agent...

# Local dev only: point TAC server at agentcore dev instead of deployed agent
# Get the port from agentcore dev output (defaults to 8080, shifts to 8081 if taken)
# AGENT_LOCAL_URL=http://localhost:8081

# ── Agent backend ───────────────────────────────────────────────────────────
# agentcore (default) — AWS AgentCore (Strands + Claude)
# vertexai             — Google Vertex AI Agent Engine (Gemini)
# elevenlabs           — ElevenLabs Conversational AI (port 8002)
AGENT_BACKEND=agentcore

# AGENT_PROVIDER selects the agent runtime for the TAC server.
# Defaults to the value of AGENT_BACKEND if not set explicitly.
# ── Vertex AI / Gemini (only needed when AGENT_BACKEND=vertexai) ────────────
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1
VERTEXAI_AGENT_ID=
# Path to GCP service account JSON key — leave blank to use Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# ── ElevenLabs (only needed when AGENT_BACKEND=elevenlabs) ──────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PORT=8002

# ── Server ports ────────────────────────────────────────────────────────────
TAC_PORT=8000   # Python TAC server (src/tac/server.py)
APP_PORT=8001   # Node.js app server (src/apps/healthcare/server/api.ts)

# ── Segment Profile API ───────────────────────────────────────────────────
SEGMENT_SPACE_ID=spc_xxx
SEGMENT_ACCESS_TOKEN=your_personal_access_token
SEGMENT_WRITE_KEY=your_source_write_key
